# Database Connection
# PostgreSQL connection string (original version)
DATABASE_URL=postgresql://username:password@hostname:port/database

# MongoDB connection string (MongoDB version)
MONGODB_URI=mongodb://username:password@hostname:port/database

# Session Secret
SESSION_SECRET=your-secret-session-key

# Public URL for QR code generation
# If not provided, it will use Replit's environment variables or localhost
# PUBLIC_URL=https://your-app-url.com